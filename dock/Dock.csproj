<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: sin esto, el autoarranque abriria una ventana de consola al iniciar
         sesion. Los mensajes no se pierden: Program engancha la consola del padre si
         se lanza desde una terminal. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <AssemblyName>Dock</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Dock</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>

    <!-- Fase 2, punto 8: nada de ofuscacion, packers ni compresion. El binario
         debe tener PDB y secciones legibles para un analizador estatico. -->
    <DebugType>portable</DebugType>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Precompilado a nativo: no recorta, no comprime y mantiene los ensamblados y el
         PDB legibles, asi que no toca la regla 8 de SEGURIDAD.md. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>

  </PropertyGroup>

  <ItemGroup>
    <None Update="dock.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Unica dependencia. Source generator: no aparece en la salida. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.333" PrivateAssets="all" />
  </ItemGroup>

</Project>
