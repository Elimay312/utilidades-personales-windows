#define DOCK_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define DOCK_EXE_RESOURCE 101
#define DOCK_EXE_PATH "@dock_exe@"
#define DOCK_MANIFEST_PATH "@dock_assets@/installer.manifest"

#endif
