// Configuracion de la isla. Vive en %LOCALAPPDATA%\Isla\isla.json.
// Admite comentarios y comas finales. Se recarga sola al guardarlo.
{
  // Nombre de dispositivo de la pantalla donde vive la isla.
  //
  // VACIO = la isla SIGUE AL RATON: se muda a la pantalla en la que estes trabajando.
  // Con varios monitores es lo que quieres casi siempre; si no, la isla avisaria en
  // una pantalla que no estas mirando. Tarda ~375 ms en decidirse, para no mudarse al
  // rozar un borde de paso.
  //
  // Con un nombre puesto se queda clavada ahi y no se mueve. Al arrancar, la isla
  // imprime en la consola las que hay: \\.\DISPLAY1, etc.
  // Ojo con las barras: en JSON hay que doblarlas -> "\\\\.\\DISPLAY2"
  "pantalla": "",

  // Cuanto dura el pomodoro de Ctrl+Alt+T.
  "pomodoroMinutos": 25,

  // Si un cambio de volumen -- o de dispositivo de salida -- hace asomar la isla.
  //
  // El aviso dice el numero Y por donde sale, que es lo que le faltaba:
  //   Volumen 48 % - LG ULTRAWIDE (NVI...
  // Y cambiar de altavoces tiene su propio aviso: el volumen que vas a oir a partir
  // de ahora es OTRO. El nombre se recorta si no cabe en la pildora.
  //
  // Windows ya ensena el suyo arriba a la izquierda y no se puede quitar (el HUD si
  // lo suprime, capturando las teclas). Ponlo en false si te sobra verlo dos veces.
  "volumenAsoma": true,

  // Autoarranque con la sesion. Escribe en HKCU\...\Run, que sale en la pestana
  // Inicio del Administrador de tareas. Por defecto no se escribe nada.
  "autoArranque": false
}
