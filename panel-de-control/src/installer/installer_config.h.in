#define PANEL_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define PANEL_EXE_RESOURCE 101
#define PANEL_EXE_PATH "@panel_exe@"
#define PANEL_MANIFEST_PATH "@panel_assets@/installer.manifest"

#endif
