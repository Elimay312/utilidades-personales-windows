#include <windows.h>

#include "app/Version.h"

// Este archivo va en UTF-8 y hay que DECIRLO. rc.exe lee los .rc sin BOM con la página de
// códigos del sistema —CP1252 aquí— así que sin esta línea «Brújula» se compila como
// «BrÃºjula» y sale así en las propiedades del archivo y, lo que se ve de verdad, en la
// cabecera de la notificación del recordatorio. No da ningún error al compilar.
//
// #pragma y no un BOM: el BOM también sirve, pero es invisible en el editor y cualquiera
// lo pierde al guardar con otra herramienta. Esto se lee.
#pragma code_page(65001)

// El manifiesto va como archivo suelto en CMakeLists para que link.exe lo funda con el
// trustInfo que genera él: si aquí hubiera también un RT_MANIFEST habría dos, y haría falta
// /MANIFEST:NO.

// La aguja de brújula. La ruta es relativa a ESTE archivo, que es como rc.exe resuelve.
// El .ico se genera con un script y se guarda en el repositorio: compilar no depende de
// tener PowerShell ni de que el script siga existiendo.
BRUJULA_ICON ICON "brujula.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BRUJULA_VERSION_MAJOR, BRUJULA_VERSION_MINOR, BRUJULA_VERSION_PATCH, 0
PRODUCTVERSION BRUJULA_VERSION_MAJOR, BRUJULA_VERSION_MINOR, BRUJULA_VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0c0a = español (España), 04b0 = Unicode.
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "FileDescription", "Brújula, priorizador de repositorios"
            VALUE "FileVersion", BRUJULA_VERSION_STR ".0"
            VALUE "InternalName", "brujula"
            VALUE "OriginalFilename", "brujula.exe"
            VALUE "ProductName", "Brújula"
            VALUE "ProductVersion", BRUJULA_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
