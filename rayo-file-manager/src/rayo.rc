#include <windows.h>

// El icono de menor ID es el que el Explorador usa para el exe, y el mismo que carga
// Window::Create para la ventana, el alt-tab y la barra de tareas.
1 ICON "rayo.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_DEBUG
#else
FILEFLAGS 0
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0c0a = espanol (Espana), 04b0 = Unicode.
        BLOCK "0c0a04b0"
        BEGIN
            VALUE "FileDescription", "Rayo, gestor de archivos"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "rayo"
            VALUE "OriginalFilename", "rayo.exe"
            VALUE "ProductName", "Rayo"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0c0a, 1200
    END
END
